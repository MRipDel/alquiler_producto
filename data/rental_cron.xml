<!-- views/rental_cron.xml --> 
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Árbol -->
    <record id="vista_alquiler_arbol" model="ir.ui.view">
        <field name="name">alquiler.producto.tree</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="producto_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <!-- Vista de Formulario -->
    <record id="vista_alquiler_formulario" model="ir.ui.view">
        <field name="name">alquiler.producto.form</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cliente_id"/>
                            <field name="producto_id"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observaciones"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="vista_alquiler_busqueda" model="ir.ui.view">
        <field name="name">alquiler.producto.search</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="producto_id"/>
                <filter string="En Alquiler" name="alquilado" domain="[('estado','=','alquilado')]"/>
                <filter string="Entregado" name="entregado" domain="[('estado','=','entregado')]"/>
                <filter string="No Entregado" name="no_entregado" domain="[('estado','=','no_entregado')]"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="accion_alquiler" model="ir.actions.act_window">
        <field name="name">Alquiler de Productos</field>
        <field name="res_model">alquiler.producto</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer alquiler de producto!
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_alquiler_raiz" 
              name="Alquiler de Productos" 
              sequence="10"/>
    
    <menuitem id="menu_alquiler" 
              parent="menu_alquiler_raiz"
              action="accion_alquiler"
              sequence="1"/>
</odoo>